<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass capsule: edge + body + specular + outer rim + inner refraction -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/safari_glass_stroke"
                android:color="@color/safari_glass_edge" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/safari_radius_capsule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/safari_glass_fill" />
            <corners android:radius="@dimen/safari_radius_capsule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/safari_glass_specular_mid"
                android:endColor="#00FFFFFF"
                android:startColor="@color/safari_glass_specular" />
            <corners android:radius="@dimen/safari_radius_capsule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/safari_glass_stroke"
                android:color="@color/safari_glass_stroke" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/safari_radius_capsule" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/safari_glass_stroke"
                android:color="@color/safari_glass_inner_stroke" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/safari_radius_inner_capsule" />
        </shape>
    </item>
</layer-list>
