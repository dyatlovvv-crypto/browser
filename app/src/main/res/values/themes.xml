<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Safari" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/safari_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@color/safari_bg</item>
        <item name="android:colorBackground">@color/safari_bg</item>
        <item name="colorOnSurface">@color/safari_text</item>
    </style>
</resources>
