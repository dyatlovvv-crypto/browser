<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Safari" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/safari_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@color/safari_bg</item>
        <item name="android:colorBackground">@color/safari_bg</item>
        <item name="colorOnSurface">@color/safari_text</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textAppearance">@style/TextAppearance.Safari.Body</item>
    </style>

    <!-- HIG-ish metrics: SF Pro ≈ system sans with tuned tracking -->
    <style name="TextAppearance.Safari.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/safari_text</item>
    </style>

    <style name="TextAppearance.Safari.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/safari_text</item>
    </style>

    <style name="TextAppearance.Safari.Address" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:textColor">@color/safari_text</item>
    </style>

    <style name="TextAppearance.Safari.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/safari_muted</item>
    </style>

    <style name="Theme.Safari.GlassDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/safari_blue</item>
        <item name="colorOnSurface">@color/safari_text</item>
    </style>

    <style name="Theme.Safari.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.Safari.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="colorPrimary">@color/safari_blue</item>
        <item name="colorOnSurface">@color/safari_text</item>
    </style>

    <style name="Widget.Safari.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
