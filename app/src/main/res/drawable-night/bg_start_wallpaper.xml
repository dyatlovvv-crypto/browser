<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#2A3A4A"
                android:endColor="#0D141C"
                android:startColor="#3D5568"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="120dp"
        android:left="-40dp"
        android:right="80dp"
        android:top="180dp">
        <shape android:shape="oval">
            <solid android:color="#44243344" />
        </shape>
    </item>
    <item
        android:bottom="-40dp"
        android:left="40dp"
        android:right="-60dp"
        android:top="320dp">
        <shape android:shape="oval">
            <solid android:color="#55182028" />
        </shape>
    </item>
</layer-list>
