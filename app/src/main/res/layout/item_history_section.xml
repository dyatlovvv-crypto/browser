<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/safari_space_xs"
    android:paddingTop="@dimen/safari_space_sm"
    android:paddingEnd="@dimen/safari_space_xs"
    android:paddingBottom="@dimen/safari_space_xs">

    <TextView
        android:id="@+id/historySectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Сегодня"
        android:textAppearance="@style/TextAppearance.Safari.LabelSmall"
        android:textColor="@color/safari_muted"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/historySectionChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/safari_space_xs"
        android:text="▾"
        android:textColor="@color/safari_blue"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
