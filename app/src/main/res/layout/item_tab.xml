<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/bg_tab_card"
        android:elevation="3dp">

        <ImageView
            android:id="@+id/tabPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEF0F3"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/tabPlaceholder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_tab_compass"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/tabCardClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tab_close"
            android:contentDescription="Закрыть"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tab_close" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <TextView
            android:id="@+id/tabFavicon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_tabs_circle"
            android:gravity="center"
            android:text="S"
            android:textColor="#3C3C43"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/safari_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
