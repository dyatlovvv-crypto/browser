<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/safari_space_sm">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <FrameLayout
            android:id="@+id/favTile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fav_tile">

            <TextView
                android:id="@+id/favLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/safari_on_primary_container"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/favDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_fav_delete"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/safari_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/favTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/safari_space_sm"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Safari.LabelSmall"
        android:textColor="@color/safari_start_title" />
</LinearLayout>
